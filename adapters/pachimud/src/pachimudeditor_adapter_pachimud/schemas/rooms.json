        "open_cmd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open Cmd"
        },
        "climb": {
          "default": false,
          "title": "Climb",
          "type": "boolean"
        }
      },
      "title": "RoomExitProto",
      "type": "object"
