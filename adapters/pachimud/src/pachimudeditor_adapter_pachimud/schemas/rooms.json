        "class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class"
        },
        "carries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Carries"
        },
        "is_player": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Player"
        },
        "time": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "is_night": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Night"
        },
        "is_fighting": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Fighting"
        },
        "has_effect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Effect"
        },
        "vnum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vnum"
        },
        "var": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Var"
        },
        "who": {
          "default": "n",
          "enum": [
            "n",
            "i"
          ],
          "title": "Who",
          "type": "string"
        }
      },
      "title": "Condition",
      "type": "object"
    },
    "ExtraDescriptionProto": {
      "properties": {
        "keywords": {
          "title": "Keywords",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "keywords",
        "text"
      ],
      "title": "ExtraDescriptionProto",
      "type": "object"
    },
    "IfBlock": {
      "description": "`if`/`else`: se la condizione e' vera le azioni di `then`, altrimenti quelle di `else`.",
      "properties": {
        "if": {
          "$ref": "#/$defs/Condition"
        },
        "then": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/IfBlock"
              }
            ]
          },
          "minItems": 1,
          "title": "Then",
          "type": "array"
        },
        "else": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/IfBlock"
              }
            ]
          },
          "title": "Else",
          "type": "array"
        }
      },
      "required": [
        "if",
        "then"
      ],
      "title": "IfBlock",
      "type": "object"
    },
    "RoomExitProto": {
      "properties": {
        "target_vnum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Vnum"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
