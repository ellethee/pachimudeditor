    "RoomProto": {
      "properties": {
        "vnum": {
          "title": "Vnum",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "sector_type": {
          "default": "INSIDE",
          "title": "Sector Type",
          "type": "string"
        },
        "flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "heal_rate": {
          "default": 100,
          "title": "Heal Rate",
          "type": "integer"
        },
        "mana_rate": {
          "default": 100,
          "title": "Mana Rate",
          "type": "integer"
        },
        "climate": {
          "anyOf": [
            {
              "enum": [
                "temperate",
                "desert",
                "arctic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Climate"
        },
        "clan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clan Id"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "area": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area"
        },
        "exits": {
          "additionalProperties": {
            "$ref": "#/$defs/RoomExitProto"
          },
          "default": {},
          "title": "Exits",
          "type": "object"
        },
        "extra_descriptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtraDescriptionProto"
          },
          "title": "Extra Descriptions",
          "type": "array"
        },
        "triggers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Trigger"
          },
          "title": "Triggers",
          "type": "array"
        }
      },
      "required": [
        "vnum",
        "name",
        "description"
      ],
      "title": "RoomProto",
      "type": "object"
    },
    "Trigger": {
      "description": "Un trigger: quando succede `type` (e `argument` e `chance` lo permettono) chi lo possiede esegue le `actions`.",
      "properties": {
        "type": {
          "enum": [
            "speech",
            "greet",
            "give",
            "random",
            "death",
            "fight",
            "hitprcnt",
            "act",
            "tell",
            "bribe",
            "all_greet",
            "entry",
            "command",
            "get",
            "drop",
            "wear",
            "enter",
            "exit"
          ],
          "title": "Type",
          "type": "string"
        },
        "argument": {
          "default": "",
          "title": "Argument",
          "type": "string"
        },
        "block": {
          "default": false,
          "title": "Block",
          "type": "boolean"
        },
        "chance": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Chance",
          "type": "integer"
        },
        "actions": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/IfBlock"
              }
            ]
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "type",
        "actions"
      ],
      "title": "Trigger",
      "type": "object"
    }
  },
  "properties": {
    "area": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area"
    },
    "rooms": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RoomProto"
      },
      "title": "Rooms",
      "type": "array"
    }
  },
  "title": "LoaderRoomsFile",
  "type": "object"
}
