          "default": null,
          "title": "Description"
        },
        "keywords": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keywords"
        },
        "is_male": {
          "default": false,
          "title": "Is Male",
          "type": "boolean"
        },
        "door_flag": {
          "default": "NONE",
          "title": "Door Flag",
          "type": "string"
        },
        "is_open": {
          "default": true,
          "title": "Is Open",
          "type": "boolean"
        },
        "is_locked": {
          "default": false,
          "title": "Is Locked",
          "type": "boolean"
